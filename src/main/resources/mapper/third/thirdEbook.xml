<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hohoedu.all_pass.third.repository.ThirdEbookRepository">

    <!--
      지점 + 연월로 이미 만들어진 이북 코드를 가져온다.
      - preschool_code 에 뒤 공백이 섞여 있어 RTRIM 으로 맞춘다 ('000' 과 '000    ' 이 공존)
      - '000_' 처럼 언더바가 붙은 변종은 의미가 확인되지 않아 제외한다
      - yy 컬럼은 orderym 과 어긋난 행이 있어 필터로 쓰지 않는다
      - 같은 교재+호수에 코드가 여러 건이면 최근 것만 남긴다.
        mgubun 이 비어 있는 행이 많아 그대로 묶으면 서로 다른 호수가 한 건으로 뭉개진다.
        (예: GX028D7H = 2호, GX07PGCR = 7호 가 둘 다 mgubun NULL)
        그래서 mgubun 이 없으면 keycode 의 호수 자리를 기준으로 삼는다
    -->
    <select id="findKeycodeList" resultType="com.hohoedu.all_pass.third._dto.ThirdDTO$KeycodeRawDTO">
        SELECT keycode,
               ggubun,
               mgubun,
               orderym
        FROM (SELECT keycode,
                     ggubun,
                     mgubun,
                     orderym,
                     ROW_NUMBER() OVER (
                         PARTITION BY ggubun, ISNULL(NULLIF(RTRIM(mgubun), ''), SUBSTRING(keycode, 3, 2))
                         ORDER BY idate DESC, keycode DESC
                         ) AS rn
              FROM hohosc_TableBookLabel
              WHERE RTRIM(preschool_code) = #{preschoolCode}
                AND orderym = #{orderym}
                AND keycode IS NOT NULL
                AND ggubun IS NOT NULL) A
        WHERE rn = 1
    </select>

</mapper>
